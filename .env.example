# Firebase web config — copy to a local .env file and fill from
# Firebase Console → Project settings → General → Your apps → Web.
# These values are public-by-design (security comes from Firestore Rules),
# but keep them out of git and set the same vars in Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
